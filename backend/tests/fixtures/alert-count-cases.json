{
    "_comment": "Shared by tests/Feature/Web/AlertCountTimezoneTest.php (server, AlertController::totalCount) and resources/js/lib/alerts.test.js (front, countAlerts), so both sides are checked against the same rows at the same instant.",
    "cases": [
        {
            "name": "Europe/Warsaw at 00:30 local: today's order is not overdue, yesterday's is",
            "timezone": "Europe/Warsaw",
            "now": "2026-06-14T22:30:00Z",
            "orders": [
                { "due_date": "2026-06-15 00:00:00", "status": "IN_PROGRESS" },
                { "due_date": "2026-06-14 00:00:00", "status": "PENDING" },
                { "due_date": "2026-06-14 00:00:00", "status": "DONE" },
                { "due_date": "2026-06-13 00:00:00", "status": "CANCELLED" },
                { "due_date": null, "status": "BLOCKED" },
                { "due_date": null, "status": "PENDING" }
            ],
            "issues": [
                { "status": "OPEN" },
                { "status": "ACKNOWLEDGED" },
                { "status": "RESOLVED" }
            ],
            "expected": { "openIssues": 2, "overdue": 1, "blocked": 1, "total": 4 }
        },
        {
            "name": "UTC at the same instant: still 2026-06-14, nothing is overdue yet",
            "timezone": "UTC",
            "now": "2026-06-14T22:30:00Z",
            "orders": [
                { "due_date": "2026-06-15 00:00:00", "status": "IN_PROGRESS" },
                { "due_date": "2026-06-14 00:00:00", "status": "PENDING" },
                { "due_date": null, "status": "BLOCKED" }
            ],
            "issues": [
                { "status": "OPEN" }
            ],
            "expected": { "openIssues": 1, "overdue": 0, "blocked": 1, "total": 2 }
        },
        {
            "name": "America/New_York at 22:00 local: UTC is already tomorrow, the plant is not",
            "timezone": "America/New_York",
            "now": "2026-06-15T02:00:00Z",
            "orders": [
                { "due_date": "2026-06-14 00:00:00", "status": "IN_PROGRESS" },
                { "due_date": "2026-06-13 00:00:00", "status": "PAUSED" }
            ],
            "issues": [],
            "expected": { "openIssues": 0, "overdue": 1, "blocked": 0, "total": 1 }
        }
    ]
}
